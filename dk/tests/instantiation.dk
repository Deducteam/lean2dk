#REQUIRE normalize.

(; single sublvl substitution ;)
def test1  := z:lvl.Lvl => (x:lvl.Lvl => lvl.var nat.z x) (lvl.inst (lvl.var (nat.s nat.z) z)).
def test1' := z:lvl.Lvl =>
    (normalize.maxS
      (sublvl.cons (sublvl.V (nat.cons (nat.s nat.z) nat.nil) (nat.s nat.z) nat.z) sublvl.nil)).
#PRINT "test1 == test1'?".
#ASSERT test1 == test1'.
#CHECK test1 == test1'.

(; nil sublvls substitution ;)
def test2  := (x:lvl.Lvl => lvl.var (nat.z) x) (lvl.inst lvl.z).
def test2' := normalize.maxS sublvl.nil.
#PRINT "test2 == test2'?".
#ASSERT test2 == test2'.
#CHECK test2 == test2'.

(; multiple sublvls substitution ;)
def test3  := z:lvl.Lvl => (x:lvl.Lvl => lvl.var (nat.z) x) (lvl.inst (lvl.max (lvl.s lvl.z) (lvl.var (nat.s nat.z) z))).
def test3' := z:lvl.Lvl =>
    (normalize.maxS
       (sublvl.cons
          (sublvl.V (nat.cons (nat.s nat.z) nat.nil) (nat.s nat.z) nat.z)
          (sublvl.cons (sublvl.C nat.nil (nat.s nat.z)) sublvl.nil))).
#PRINT "test3 == test3'?".
#ASSERT test3 == test3'.
#CHECK test3 == test3'.

(;
def one := nat.s nat.z
def two := nat.s one
def three := nat.s two
def four := nat.s three

def test4  := V:lvl.Lvl => C:lvl.Lvl => c:lvl.Lvl => d:lvl.Lvl =>
  (x:lvl.Lvl => y:lvl.Lvl => sublvl.cons (sublvl.C (lvl.cons x (lvl.cons y lvl.nil)) (nat.s nat.z)) sublvl.nil) 
    (normalize.maxS (sublvl.cons (sublvl.C (lvl.cons V lvl.nil) (nat.s nat.z)) (sublvl.cons (sublvl.C (lvl.cons C lvl.nil) (nat.s nat.z)) sublvl.nil)))
    (normalize.maxS (sublvl.cons (sublvl.C (lvl.cons c lvl.nil) (nat.s nat.z)) (sublvl.cons (sublvl.C (lvl.cons d lvl.nil) (nat.s nat.z)) sublvl.nil)))
    .
def test4' := V:lvl.Lvl => C:lvl.Lvl => c:lvl.Lvl => d:lvl.Lvl =>
  (sublvl.cons
    (sublvl.C (lvl.cons V (lvl.cons c lvl.nil)) (nat.s nat.z))
  (sublvl.cons
    (sublvl.C (lvl.cons V (lvl.cons d lvl.nil)) (nat.s nat.z))
  (sublvl.cons
    (sublvl.C (lvl.cons C (lvl.cons c lvl.nil)) (nat.s nat.z))
  (sublvl.cons
    (sublvl.C (lvl.cons C (lvl.cons d lvl.nil)) (nat.s nat.z))
    sublvl.nil)))).
#PRINT "test4 == test4'?".
#ASSERT test4 == test4'.
#CHECK test4 == test4'.
parallel substitution ;)
