def maxS: sublvl.Set -> lvl.Lvl.

[l] lvl.var _ (lvl.inst l) --> l
[l] lvl.var l _ --> maxS (sublvl.cons (sublvl.V (nat.cons l nat.nil) l nat.z) sublvl.nil).

def srule: sublvl.SubLvl -> sublvl.SubLvl -> lvl.Lvl.

[l1, l2, n, m, x] srule (sublvl.V l1 x n) (sublvl.C l2 m) -->
lvl.max
  (maxS (sublvl.cons (sublvl.V (nat.merge l1 l2) x n) sublvl.nil))
  (maxS (sublvl.cons (sublvl.C l2 m) sublvl.nil)).

[l1, l2, n, m] srule (sublvl.C l1 n) (sublvl.C l2 m) -->
lvl.max
  (maxS (sublvl.cons (sublvl.C (nat.merge l1 l2) n) sublvl.nil))
  (maxS (sublvl.cons (sublvl.C l2 m) sublvl.nil)).

[l1, l2, n, m, x] srule (sublvl.C l1 n) (sublvl.V l2 x m) -->
lvl.max
  (maxS (sublvl.cons (sublvl.C (nat.merge l1 l2) n) sublvl.nil))
  (maxS (sublvl.cons (sublvl.V l2 x m) sublvl.nil)).

[l1, l2, n, m, x, y] srule (sublvl.V l1 x n) (sublvl.V l2 y m) -->
lvl.max
  (maxS (sublvl.cons (sublvl.V (nat.merge l1 l2) x n) sublvl.nil))
  (maxS (sublvl.cons (sublvl.V l2 y m) sublvl.nil)).

[] lvl.z --> maxS sublvl.nil.

[] lvl.s (maxS sublvl.nil) -->
maxS (sublvl.cons (sublvl.C nat.nil (nat.s nat.z)) sublvl.nil).
[u, q] lvl.s (maxS (sublvl.cons u q)) -->
maxS (sublvl.s (sublvl.cons u q)).

[l] lvl.max (maxS l) (maxS sublvl.nil) --> maxS l.
[u, l1, l2] lvl.max (maxS l1) (maxS (sublvl.cons u l2)) --> 
  lvl.max 
  (maxS (sublvl.maxadd l1 u)) 
  (maxS l2).

def rulehelper: sublvl.SubLvl -> lvl.Lvl -> lvl.Lvl.
[u] rulehelper u (maxS sublvl.nil) -->
  maxS sublvl.nil.
[u, v, q] rulehelper u (maxS (sublvl.cons v q)) -->
  lvl.max (srule u v) (rulehelper u (maxS q)).

[t] lvl.imax (maxS sublvl.nil) t --> t.
[u, q, t] lvl.imax (maxS (sublvl.cons u q)) t --> 
  lvl.max (rulehelper u t) (lvl.imax (maxS q) t).
