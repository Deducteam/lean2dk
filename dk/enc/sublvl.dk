SubLvl: Type.

V: nat.Set -> nat.Nat -> nat.Nat -> SubLvl.
C: nat.Set -> nat.Nat -> SubLvl.

def subs: SubLvl -> SubLvl -> bool.Bool.

[] subs (C _ nat.z) (V _ _ _) --> bool.true.
[] subs (V _ _ _) (C _ _) --> bool.false.
[l1, l2, n, m] subs (C l1 n) (C l2 m) --> bool.and (nat.subset l2 l1) (nat.leq n m).

(; FIXME should not match on (nat.s n) ;)
[l1, l2, n, m, x] subs (C l1 (nat.s n)) (V l2 x m) --> 
  bool.and (nat.subset l2 l1) (nat.leq n m)

[l1, l2, n, m, x, y] subs (V l1 x n) (V l2 y m) -->
  bool.and (nat.subset l2 l1) (bool.and (nat.eq x y) (nat.leq n m)).


def leq: SubLvl -> SubLvl -> bool.Bool.
[] leq (V _ _ _) (C _ _) --> bool.true.
[] leq (C _ _) (V _ _ _) --> bool.false. 
[l1, l2, n, m] leq (C l1 n) (C l2 m) --> bool.or
  (nat.lqset l1 l2)
  (bool.and (nat.eqset l1 l2) (nat.leq n m)).
[l1, l2, n, m, x, y] leq (V l1 x n) (V l2 y m) --> bool.or
  (nat.lqset l1 l2)
  (bool.and
    (nat.eqset l1 l2)
    (bool.and (nat.eq x y) (nat.leq n m))
  ).

Set: Type.
nil: Set.
cons: SubLvl -> Set -> Set.

def single: SubLvl -> Set.
[s] single s --> cons s nil.

def iteset: bool.Bool -> Set -> Set -> Set.
[n] iteset bool.true n _ --> n.
[n] iteset bool.false _ n --> n.

def eq: SubLvl -> SubLvl -> bool.Bool.

[l1, l2, n, m] eq (C l1 n) (C l2 m) --> bool.and (nat.eq n m) (nat.eqset l1 l2).
[l1, l2, n, m, x, y] eq (V l1 x n) (V l2 y m) --> 
  bool.and (nat.eq n m) (bool.and (nat.eq x y) (nat.eqset l1 l2)).
[] eq (V _ _ _) (C _ _) --> bool.false.
[] eq (C _ _) (V _ _ _) --> bool.false.

def add: Set -> SubLvl -> Set.
[n] add nil n --> cons n nil.
[n, m, l] add (cons n l) m --> iteset (eq n m) (cons n l) (iteset (leq n m) (cons n (add l m)) (cons m (cons n l))).

def maxadd: Set -> SubLvl -> Set.
[u] maxadd nil u --> cons u nil.
[u, l, v] maxadd (cons u l) v --> iteset (subs v u) 
  (add l u) 
  (iteset (subs u v) 
    (add l v) 
    (add (maxadd l v) u)
  ).
